FROM node:20-alpine AS build

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Use ci for deterministic, faster installations in CI/CD environments
RUN npm ci

# Copy the rest of the code files
COPY . .

# Build the application
RUN npm run build

# Nginx stage for serving the built frontend
FROM nginx:alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built static files from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Best practice: Don't run as root where possible, 
# although nginx user is typically used and requires port 80 (well-known port).
# For port 80, we stick to default setup or we could use unprivileged nginx.

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
