FROM python:3.11-slim

# Prevent Python from writing .pyc files and keeping stdout unbuffered
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system dependencies (including libpq-dev for the gateway)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create a non-root user and group for security
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Copy all requirements files to install all dependencies for the gateway
COPY auth/requirements.txt auth/
COPY pdf_processor/requirements.txt pdf_processor/
COPY image_processor/requirements.txt image_processor/
COPY csv_importer/requirements.txt csv_importer/
COPY mongo_graph/requirements.txt mongo_graph/
COPY nlp_to_mongo/requirements.txt nlp_to_mongo/

# Combine and install all requirements
RUN cat auth/requirements.txt \
    pdf_processor/requirements.txt \
    image_processor/requirements.txt \
    csv_importer/requirements.txt \
    mongo_graph/requirements.txt \
    nlp_to_mongo/requirements.txt > /tmp/all_reqs.txt && \
    pip install --no-cache-dir -r /tmp/all_reqs.txt

# Copy the entire application code
COPY . .

# Change ownership of the app directory to the non-root user
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Set PYTHONPATH
ENV PYTHONPATH=/app

# Run the gateway
CMD ["python", "-m", "uvicorn", "gateway:gateway", "--host", "0.0.0.0", "--port", "8000"]
